{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Bash|WebFetch",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-public.mjs\"" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-checks.mjs\"" }]
      }
    ]
  }
}
